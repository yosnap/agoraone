# Configuración exclusiva del backend. Nunca usar prefijo VITE_ para secretos.
# Se detectan ~/.hermes y ~/.hermes/hermes-agent automáticamente.
# Opcionales para instalaciones en otra ubicación (solo backend):
# AGORA_HERMES_HOME=/ruta/datos/hermes
# AGORA_HERMES_PATH=/ruta/codigo/hermes-agent
# AGORA_HERMES_PYTHON=/ruta/codigo/hermes-agent/venv/bin/python
# Adaptador inicial: proveedor OpenAI compatible, sin agentes CLI externos.
# Completar con el proveedor/modelo elegido antes de llamar a Hermes.
AGORA_MODEL=
AGORA_BASE_URL=
AGORA_API_KEY=
