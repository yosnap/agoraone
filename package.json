{
  "name": "agoraone",
  "version": "1.6.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node desktop/scripts/auxiliares.mjs && concurrently -k -n backend,web \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "cargo run -q --manifest-path desktop/Cargo.toml --bin agoraone",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:core": "cd core && uv run --frozen pytest -q",
    "start": "AGORA_WEB_PORT=4317 cargo run -q --release --manifest-path desktop/Cargo.toml --bin agoraone",
    "check:hermes": "cargo run -q --manifest-path desktop/Cargo.toml --bin agoraone -- comprobar-hermes",
    "open": "cargo run -q --manifest-path desktop/Cargo.toml --bin agoraone -- abrir",
    "helpers": "node desktop/scripts/auxiliares.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "3.1.3",
    "postprocessing": "6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jszip": "^3.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.5.1"
}
