<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundled Python under the hardened runtime: native extensions (cffi, lxml, numpy) need writable
     executable memory for their callbacks. The core reads the calendars and reminders through EventKit
     once the user allows it (macOS asks with the app's own wording). Nothing else is allowed. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
</dict>
</plist>
